# Rename this file to backend.tf after creating the state bucket and DynamoDB lock table.
# Keeping state outside the repository is required for a real team workflow.
terraform {
  backend "s3" {
    bucket       = "REPLACE_WITH_STATE_BUCKET"
    key          = "event-management/prod/terraform.tfstate"
    region       = "us-east-1"
    use_lockfile = true
    encrypt      = true
  }
}
